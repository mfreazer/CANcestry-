  "cards": [
    {
      "dot": "cyan",
      "title": "Deterministic runtime",
      "items": [
        "Bounded queues and bounded memory; deterministic event processing",
        "Monotonic \u00b5s clock; priority-ordered events (FAULT < MODE < TIMER < CAN_RX < HOST)",
        "Same portable core in firmware and in host simulation"
      ]
    },
    {
      "dot": "emerald",
      "title": "Declarative packages",
      "items": [
        "Codec maps, recipes, and FSM definitions ship as declarative packages",
        "Package Manager validates schemas, resolves dependencies, enforces capabilities",
        "Storage holds packages, configuration, and trace logs"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety governor authority",
      "items": [
        "No action executes a side effect before governor approval",
        "TX permissions, rate limits, and signal-write blocks enforced on every request",
        "Approved frames leave via the CAN Core; a critical fault drops the system into SAFE with TX disabled"
      ]
    }
  ]
