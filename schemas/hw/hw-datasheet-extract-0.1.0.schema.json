{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cancestry.dev/schemas/hw/hw-datasheet-extract-0.1.0.schema.json",
  "title": "CANcestry hardware datasheet parameter extract (v0.1.0)",
  "description": "Schema for a hardware datasheet parameter extract under hw/bom/datasheets/ (issue #35, H-02; HwAGENTS.md rule 2, HW-PLAN §7/§9). Cites manufacturer, document ID, and retrieval date. Every parameter carries a source discriminator and citation. Numbers without an extract are defects. H-04 (HW-SF-002, HW-FR-009): source_pdf_hash is mandatory; null explicitly records no retained PDF and requires source_url. The requested urn:cancestry:schema:hw:datasheet-extract-0.1.0 ID is deferred because the shared schema gate is frozen for this issue.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "source",
    "entries"
  ],
  "properties": {
    "kind": {
      "const": "datasheet_extract"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manufacturer",
        "document_id",
        "retrieval_date",
        "source_pdf_hash"
      ],
      "properties": {
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "retrieval_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source_pdf_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^\\s]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_pdf_hash": {
                "type": "null"
              }
            },
            "required": [
              "source_pdf_hash"
            ]
          },
          "then": {
            "required": [
              "source_url"
            ]
          }
        }
      ]
    },
    "note": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit",
          "condition",
          "citation"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "hwers",
              "datasheet",
              "budget",
              "standard"
            ]
          },
          "citation_type": {
            "enum": [
              "datasheet",
              "budget"
            ]
          },
          "citation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
