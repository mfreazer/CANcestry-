{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cancestry.dev/schemas/fsm-0.3.0.schema.json",
  "title": "CANcestry FSM File v0.3.0",
  "description": "FSM file schema for the v0.3.0 release candidate (issue #13). Finalizes the v0.2.0 declaration structure unchanged: the Phase 4 FSM runtime needs no new file-level fields (chain depth, deferred transitions, missed-tick handling and queue policy are runtime behavior, not declaration syntax; issue #11 Flag 1). Fields that are sometimes asked about, such as `layout` (a codec-map signal field) and `priority` (a runtime event priority class), are deliberately not part of the FSM schema and are rejected at load time by `additionalProperties: false` at every level.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_machines",
    "instances"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0",
      "description": "Schema version this document targets. The loader accepts \"0.2.0\" and \"0.3.0\"; both schemas define the identical declaration structure, so a 0.2.0 file is a valid 0.3.0 file apart from this field."
    },
    "state_machines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/state_machine"
      }
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/instance"
      }
    }
  },
  "$defs": {
    "state_machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "initial",
        "states"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "initial": {
          "type": "string"
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable_definition"
          }
        },
        "timers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timer_definition"
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/state_definition"
          }
        }
      }
    },
    "variable_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "boolean",
            "integer",
            "float"
          ]
        },
        "default": {
          "$ref": "#/$defs/expression_or_literal"
        }
      }
    },
    "timer_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "duration_ms",
        "repeat",
        "auto_start"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "repeat": {
          "type": "boolean"
        },
        "auto_start": {
          "type": "boolean"
        }
      }
    },
    "state_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "entry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fsm_action"
          }
        },
        "exit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fsm_action"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition_definition"
          }
        }
      }
    },
    "transition_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "target"
      ],
      "properties": {
        "event": {
          "enum": [
            "can_rx",
            "signal_changed",
            "timer_expired",
            "state_entered",
            "state_exited",
            "fault_raised",
            "power_mode_changed"
          ]
        },
        "interface": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "signal": {
          "type": "string"
        },
        "timer": {
          "type": "string"
        },
        "guard": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fsm_action"
          }
        },
        "target": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "event": {
                "const": "timer_expired"
              }
            },
            "required": [
              "event"
            ]
          },
          "then": {
            "required": [
              "timer"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "event": {
                "const": "signal_changed"
              }
            },
            "required": [
              "event"
            ]
          },
          "then": {
            "required": [
              "signal"
            ]
          }
        }
      ]
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "machine",
        "enabled"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/expression_or_literal"
          }
        },
        "subscriptions": {
          "$ref": "#/$defs/subscriptions"
        }
      }
    },
    "subscriptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "can_rx": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/can_rx_subscription"
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timers": {
          "type": "boolean"
        },
        "faults": {
          "type": "boolean"
        },
        "power_mode": {
          "type": "boolean"
        }
      }
    },
    "can_rx_subscription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface"
      ],
      "properties": {
        "interface": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/can_id"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "can_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 536870911
    },
    "expression_or_literal": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ]
    },
    "fsm_action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "send_message"
          ],
          "properties": {
            "send_message": {
              "$ref": "#/$defs/send_message"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "set_signal"
          ],
          "properties": {
            "set_signal": {
              "$ref": "#/$defs/set_signal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "set_variable"
          ],
          "properties": {
            "set_variable": {
              "$ref": "#/$defs/set_variable"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_timer"
          ],
          "properties": {
            "start_timer": {
              "$ref": "#/$defs/start_timer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stop_timer"
          ],
          "properties": {
            "stop_timer": {
              "$ref": "#/$defs/timer_name_action"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reset_timer"
          ],
          "properties": {
            "reset_timer": {
              "$ref": "#/$defs/timer_name_action"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "log"
          ],
          "properties": {
            "log": {
              "$ref": "#/$defs/log_action"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raise_fault"
          ],
          "properties": {
            "raise_fault": {
              "$ref": "#/$defs/raise_fault_action"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transition"
          ],
          "properties": {
            "transition": {
              "$ref": "#/$defs/transition_action"
            }
          }
        }
      ]
    },
    "send_message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "message",
        "signals"
      ],
      "properties": {
        "interface": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "signals": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/expression_or_literal"
          }
        }
      }
    },
    "set_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal",
        "value"
      ],
      "properties": {
        "signal": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/expression_or_literal"
        }
      }
    },
    "set_variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable",
        "value"
      ],
      "properties": {
        "variable": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/expression_or_literal"
        }
      }
    },
    "start_timer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timer"
      ],
      "properties": {
        "timer": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "repeat": {
          "type": "boolean"
        }
      }
    },
    "timer_name_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timer"
      ],
      "properties": {
        "timer": {
          "type": "string"
        }
      }
    },
    "log_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "message"
      ],
      "properties": {
        "level": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "raise_fault_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "error",
            "critical"
          ]
        }
      }
    },
    "transition_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "type": "string"
        }
      }
    }
  }
}
