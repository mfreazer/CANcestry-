{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cancestry.dev/schemas/hw/hw-plot-data-0.1.0.schema.json",
  "title": "CANcestry Hardware Plot Data 0.1.0",
  "description": "Uniform hash-chain contract for hardware visual evidence (issue #36, H-03; HwAGENTS.md rule 13). Every committed SVG under hw/tests/evidence/renders/ MUST be rendered from exactly one plot-data file conforming to this schema. The plot-data file references a hashed evidence artifact; the picture is a view of that artifact, never the proof of it. ci/check_hw_evidence.py enforces this contract fail-closed. Schema identifier convention: this document keeps the https://cancestry.dev/... $id used by the existing hardware schemas because the shared software validator (ci/check_schemas_valid.py) requires a versioned .schema.json identifier and the URN migration is a separately approved change tracked by issue #40; no software gate is modified by H-03.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plot_id",
    "plot_version",
    "source_evidence_hash",
    "source_evidence_path",
    "method",
    "credibility_level",
    "status",
    "provisional",
    "oracle_id",
    "renderer_tool",
    "renderer_tool_version",
    "renderer_tool_digest",
    "series"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "plot_id": {
      "$ref": "#/$defs/plot_id"
    },
    "plot_version": {
      "$ref": "#/$defs/semver"
    },
    "plot_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "plot_description": {
      "type": "string",
      "maxLength": 2048
    },
    "source_evidence_hash": {
      "$ref": "#/$defs/hash"
    },
    "source_evidence_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S",
      "$comment": "Repo-relative path to the evidence JSON whose sha256 equals source_evidence_hash. Absolute paths and '..' escapes are rejected by the checker."
    },
    "source_requirement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "method": {
      "$ref": "#/$defs/method"
    },
    "credibility_level": {
      "$ref": "#/$defs/credibility_level"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "provisional": {
      "type": "boolean",
      "$comment": "Required so the footer STATUS suffix (…,provisional) can never be silently omitted. Absence is not allowed; write false explicitly."
    },
    "oracle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^OR-\\d{3}$",
      "$comment": "Oracle from the normative hw/tests/oracles/registry.json (HW-PLAN section 10.2). A plot cannot create an oracle."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "$comment": "Optional. If present, MUST be derived from SOURCE_DATE_EPOCH (or copied from an already-hashed input) so re-rendering the same plot-data is byte-identical. No wall-clock timestamps."
    },
    "renderer_tool": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "$comment": "Renderer id; resolves to <renderers-dir>/<renderer_tool>.py for the --rerender check (visual-evidence-plan section 6)."
    },
    "renderer_tool_version": {
      "$ref": "#/$defs/semver"
    },
    "renderer_tool_digest": {
      "$ref": "#/$defs/hash"
    },
    "tolerance_band": {
      "$ref": "#/$defs/tolerance_band"
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/series"
      }
    },
    "provenance_notes": {
      "type": "string",
      "maxLength": 2048
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "series": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "role": {
                  "enum": [
                    "tolerance_lower",
                    "tolerance_upper"
                  ]
                }
              },
              "required": [
                "role"
              ]
            }
          }
        },
        "required": [
          "series"
        ]
      },
      "then": {
        "required": [
          "tolerance_band"
        ]
      }
    },
    {
      "if": {
        "required": [
          "tolerance_band"
        ]
      },
      "then": {
        "properties": {
          "series": {
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "const": "tolerance_lower"
                    }
                  },
                  "required": [
                    "role"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "const": "tolerance_upper"
                    }
                  },
                  "required": [
                    "role"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "plot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "method": {
      "enum": [
        "analysis",
        "sim",
        "virtual_bench",
        "protocol",
        "bench"
      ],
      "$comment": "MUST be kept in lockstep with schemas/hw/hw-traceability-0.1.0.schema.json and the METHODS tuple in ci/check_hw_traceability.py (HW-PLAN section 10.1 tiers). 'protocol' is the T3 protocol-conformance method; it does not raise a plot's evidence tier."
    },
    "credibility_level": {
      "enum": [
        "CL0",
        "CL1",
        "CL2",
        "CL3"
      ],
      "$comment": "ASME V&V 40-style credibility of the claim (HW-PLAN section 10.3). CL0: no credibility established; placeholder pending first analysis or simulation. A rendered plot never raises the credibility of its source evidence."
    },
    "status": {
      "enum": [
        "passing",
        "pending",
        "failing"
      ],
      "$comment": "Must agree with the source evidence artifact: evidence pass=true corresponds to passing; pending/failing plots must not be rendered as if they passed (HwAGENTS.md rules 4 and 13)."
    },
    "non_color_encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_style",
        "marker"
      ],
      "properties": {
        "line_style": {
          "enum": [
            "solid",
            "dashed",
            "dotted",
            "dashdot"
          ],
          "$comment": "Mandatory: series must be distinguishable without color (accessibility, H-03 section 7)."
        },
        "marker": {
          "enum": [
            "none",
            "circle",
            "square",
            "triangle",
            "diamond",
            "cross",
            "x"
          ]
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "x",
        "y",
        "x_units",
        "y_units",
        "non_color_encoding"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "$comment": "Unique within the plot-data file; referenced by name from tolerance_band and by the footer/comment verification."
        },
        "role": {
          "enum": [
            "model",
            "oracle",
            "tolerance_lower",
            "tolerance_upper"
          ],
          "$comment": "model: the artifact under test (for example the Modelica FMU trace). oracle: the independent reference. tolerance_lower/tolerance_upper: the admissible band around the oracle."
        },
        "x": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100000,
          "items": {
            "type": "number"
          }
        },
        "y": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100000,
          "items": {
            "type": "number"
          }
        },
        "x_units": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "y_units": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "non_color_encoding": {
          "$ref": "#/$defs/non_color_encoding"
        },
        "description": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "tolerance_band": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower_series",
        "upper_series",
        "description"
      ],
      "properties": {
        "lower_series": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "upper_series": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "$comment": "Human-readable declaration of the tolerance, for example '±1 mV per sample, per OR-001'."
        },
        "hatch": {
          "enum": [
            "///",
            "...",
            "xxx",
            "+++",
            "---",
            "|||"
          ],
          "$comment": "Greyscale-safe hatch pattern for the shaded band (H-03 section 7). Optional; the renderer documents its default."
        },
        "units": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    }
  }
}
