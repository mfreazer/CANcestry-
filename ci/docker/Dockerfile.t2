# CANcestry T2 virtual-bench toolchain image (issue #55, H-08).
#
# Everything the T2 live co-simulation needs in one digest-pinned image:
#
#   * OpenModelica (omc) - headless build of the FMI 2.0 CS Holdup FMU
#     (same base image, same OM version and same MSL 4.0.0 as the H-01
#     toolchain image, so the T2 plant build stands on the T1-qualified
#     toolchain; keep ci/docker/Dockerfile light - it stays T1-only)
#   * Renode v1.16.1 portable (self-contained .NET 8 runtime) - the virtual
#     bench; identity-pinned by ci/docker/renode-1.16.1.pin
#   * arm-none-eabi-gcc + newlib - cross-build of the off-tree T2 ELF from
#     the tag v1.0.0 firmware sources
#   * Python 3.10+ venv with the pinned FMPy 0.3.24 (bounded FMU executor)
#
# Determinism (HwAGENTS.md rule 5): the base is pinned by digest
# (ci/docker/base-image.digest); the Renode asset is pinned by identity
# (ci/docker/renode-1.16.1.pin) and its MEASURED sha256 is printed to the
# build log, which the hw-nightly t2-virtual-bench job carries into the
# run log evidence.

FROM openmodelica/openmodelica:v1.24.0-minimal@sha256:ab60ed68b4ba3aafa3cddb6319b31ead0346416fb0f2b62bdd7a9e19b486227b

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# Cross toolchain for the T2 firmware ELF (tag v1.0.0 sources, off-tree
# driver). arm-none-eabi-gcc ships the newlib C library needed by the
# -nostartfiles link.
# The minimal OM base may lack curl; install it with the cross toolchain.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        arm-none-eabi-gcc \
        arm-none-eabi-newlib \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Renode v1.16.1 portable (self-contained .NET 8 runtime). The identity pin
# (release tag, asset id, exact byte size) lives in ci/docker/renode-1.16.1.pin;
# the measured sha256 of the fetched bytes is recorded in the build log and
# carried into the run log evidence by the hw-nightly job.
ARG RENODE_URL=https://github.com/renode/renode/releases/download/v1.16.1/renode-1.16.1.linux-portable-dotnet.tar.gz
ARG RENODE_SIZE=77304986
RUN set -eux; \
    curl -fsSL --retry 3 -o /tmp/renode.tar.gz "$RENODE_URL"; \
    test "$(stat -c%s /tmp/renode.tar.gz)" = "$RENODE_SIZE"; \
    echo "renode_asset_sha256_measured: $(sha256sum /tmp/renode.tar.gz | cut -d' ' -f1)"; \
    mkdir -p /opt/renode; \
    # Official portable layout (README): single top-level directory; the \
    # launcher sits at its root (bin/ holds the runtime files). \
    tar -xzf /tmp/renode.tar.gz -C /opt/renode --strip-components=1; \
    if [ -x /opt/renode/renode ]; then \
        ln -s /opt/renode/renode /usr/local/bin/renode; \
    elif [ -x /opt/renode/bin/renode ]; then \
        ln -s /opt/renode/bin/renode /usr/local/bin/renode; \
    else \
        echo "renode entry point not found in the portable package" >&2; \
        find /opt/renode -maxdepth 2 -type f | head -50 >&2; \
        exit 1; \
    fi; \
    rm -f /tmp/renode.tar.gz; \
    # Smoke test: the pinned release must identify itself as 1.16.x. \
    renode --version

# The OpenModelica minimal image intentionally omits the Modelica Standard
# Library. Install the pinned MSL (same as the H-01 image) so the FMU build
# is offline and reproducible at docker-run time.
RUN printf '%s\n' \
    'updatePackageIndex();' \
    'installPackage(Modelica, "4.0.0");' \
    'getErrorString();' \
    > /tmp/install-modelica.mos \
    && omc /tmp/install-modelica.mos \
    && rm -f /tmp/install-modelica.mos

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv \
    && python3 -m venv /opt/venv \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/venv/bin:${PATH}"

# Same Python pins as the H-01 toolchain image (fmpy 0.3.24 is the TCL1
# bounded doStep/readout executor, docs/hw/tool-qualification.md section 3).
RUN python3 -m pip install \
    fmpy==0.3.24 \
    numpy==2.1.3 \
    jsonschema==4.23.0 \
    pytest==8.3.2
