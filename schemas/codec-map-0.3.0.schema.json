{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cancestry.dev/schemas/codec-map-0.3.0.schema.json",
  "title": "CANcestry Codec Map v0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "codec_map"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "codec_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "messages"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "description": {
          "type": "string"
        },
        "can_fd": {
          "type": "boolean",
          "default": false,
          "description": "When true the map is a CAN FD map: messages may declare a dlc above 8 and signals may address payload bits 0..511 (Phase 7, issue #20). When false or absent the map is classic CAN and keeps the v0.2.0 limits (dlc 0..8, payload bits 0..63). The runtime additionally refuses a can_fd map at load time when the target platform does not support CAN FD (SW-FR-CANFD-004)."
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/message"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "can_fd": {
                "const": true
              }
            },
            "required": [
              "can_fd"
            ]
          },
          "then": {
            "properties": {
              "messages": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/fd_message"
                }
              }
            }
          },
          "else": {
            "properties": {
              "messages": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/classic_message"
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "can_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 536870911
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "dlc",
        "signals"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/can_id"
        },
        "name": {
          "type": "string"
        },
        "dlc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "Declared payload length in bytes. The allowed values depend on codec_map.can_fd: 0..8 for a classic map, and the CAN FD payload lengths 0-8, 12, 16, 20, 24, 32, 48, 64 for a CAN FD map (see classic_message / fd_message)."
        },
        "period_ms": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string"
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/signal"
          }
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "start_bit",
        "bit_length",
        "type",
        "endianness"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "start_bit": {
          "type": "integer",
          "minimum": 0
        },
        "bit_length": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "uint",
            "int",
            "boolean",
            "enum"
          ]
        },
        "endianness": {
          "enum": [
            "little",
            "big"
          ]
        },
        "scale": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "values": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]+$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "strict": {
          "type": "boolean"
        },
        "layout": {
          "enum": [
            "contiguous",
            "sawtooth"
          ]
        },
        "bit_layout": {
          "enum": [
            "contiguous",
            "sawtooth"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "bit_length": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "values"
            ]
          }
        }
      ]
    },
    "classic_message": {
      "description": "A message in a classic CAN map: dlc is at most 8 bytes and signals address payload bits 0..63 (SW-FR-CANFD-001, backwards compatible with codec-map v0.2.0).",
      "allOf": [
        {
          "$ref": "#/$defs/message"
        },
        {
          "properties": {
            "dlc": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            }
          }
        },
        {
          "properties": {
            "signals": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/classic_signal"
              }
            }
          }
        }
      ]
    },
    "fd_message": {
      "description": "A message in a CAN FD map: dlc is one of the payload lengths CAN FD can put on the wire (ISO 11898-1 DLC codes 0..15) and signals may address payload bits 0..511 (SW-FR-CANFD-001).",
      "allOf": [
        {
          "$ref": "#/$defs/message"
        },
        {
          "properties": {
            "dlc": {
              "enum": [
                0,
                1,
                2,
                3,
                4,
                5,
                6,
                7,
                8,
                12,
                16,
                20,
                24,
                32,
                48,
                64
              ]
            }
          }
        },
        {
          "properties": {
            "signals": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fd_signal"
              }
            }
          }
        }
      ]
    },
    "fd_signal": {
      "description": "A signal in a CAN FD map. start_bit may address any of the 512 payload bits of a 64-byte frame; the signal must still be at most 64 bits wide.",
      "allOf": [
        {
          "$ref": "#/$defs/signal"
        },
        {
          "properties": {
            "start_bit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 511
            }
          }
        }
      ]
    },
    "classic_signal": {
      "description": "A signal in a classic CAN map: start_bit addresses one of the 64 payload bits of an 8-byte frame (unchanged from codec-map v0.2.0).",
      "allOf": [
        {
          "$ref": "#/$defs/signal"
        },
        {
          "properties": {
            "start_bit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            }
          }
        }
      ]
    }
  },
  "description": "Codec map schema for the CANcestry codec engine. v0.3.0 adds CAN FD support (Phase 7, issue #20): the optional codec_map.can_fd flag switches the message dlc and signal start_bit vocabularies between classic CAN (8 bytes, 64 payload bits) and CAN FD (up to 64 bytes, 512 payload bits). Maps without the flag validate exactly as they did before, so the change is backwards compatible."
}
