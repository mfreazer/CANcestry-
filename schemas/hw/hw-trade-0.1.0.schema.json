{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cancestry.dev/schemas/hw/hw-trade-0.1.0.schema.json",
  "title": "CANcestry hardware trade (v0.1.0)",
  "description": "Implements HW-FR-001..003, HW-FR-009..010, HW-SF-002..003 and HW-SF-005. Architectural trade records are authoritative; mbse-plan Appendix A is generated. Null selections/weights/rejection rationales mean not decided, not a silently approved design.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trades"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "trades": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trade_id",
          "title",
          "motivating_requirement_or_risk",
          "owner",
          "target_phase",
          "status",
          "options_considered",
          "selected_option",
          "decision_criteria",
          "decision_rationale"
        ],
        "properties": {
          "trade_id": {
            "type": "string",
            "pattern": "^T-0[1-4]$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "motivating_requirement_or_risk": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "target_phase": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "recorded",
              "decided"
            ]
          },
          "options_considered": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "rationale_for_rejection"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "rationale_for_rejection": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "selected_option": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "decision_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criterion",
                "weight"
              ],
              "properties": {
                "criterion": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "weight": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "decision_rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "recorded"
                }
              }
            },
            "then": {
              "properties": {
                "selected_option": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "selected_option": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "decision_criteria": {
                  "items": {
                    "properties": {
                      "weight": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
